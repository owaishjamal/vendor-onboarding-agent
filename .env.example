# Copy to .env and adjust. Every value has a working default — the system runs
# end to end, and demos, with no changes and no API key.

# ---------------------------------------------------------------------------
# LLM provider: offline | anthropic | openai | gemini
#
# "offline" composes the vendor email and reviewer summary from templates
# instead of calling a model. Every check, every finding, every status and the
# whole UI behave identically — only the wording of the two generated
# documents differs. Keep this as the fallback for live demos.
# ---------------------------------------------------------------------------
LLM_PROVIDER=offline
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cache generated text by content hash. Recommended: removes API cost during
# iteration and makes a rehearsed demo immune to rate limits.
LLM_CACHE_ENABLED=1

# Pause between checks so the live view is readable. Presentation only.
# Set to 0 for real throughput (tests run with 0).
CHECK_DELAY_MS=400

# Point SQLite at local disk if the project lives on OneDrive, a mapped
# network drive, or any synced folder.
# VO_DB_PATH=C:/temp/vendor-cases.db
