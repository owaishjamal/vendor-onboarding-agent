# Copy to .env and adjust. Every value has a working default — the system runs
# end to end, and demos, with no changes and no API key.
#
# NEVER put a real key in THIS file. It is committed to git. Your real .env is
# gitignored (see .gitignore). A key that reaches a public repository must be
# treated as burned and rotated immediately, whatever the repo's visibility.

# ---------------------------------------------------------------------------
# LLM PROVIDERS
#
# Provider selection is handled by the LLM router (docs/LLM-Router.md). Set
# whichever keys you have; the router uses what is present, skips the rest by
# name, and picks a provider per request from live rate-limit and health
# state. You do NOT choose a provider here — that is the point of the router,
# and pinning one would give up the failover.
#
# With no key at all the app runs on deterministic templates. Every check,
# finding, status and screen behaves identically; only the wording of the two
# generated documents differs. Keep that as the fallback for live demos.
# ---------------------------------------------------------------------------

# Groq — fastest tokens/sec. https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — same open-weights models, separate quota, so a Groq 429 says
# nothing about it. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google Gemini — the only one of the three with vision and a genuinely long
# context, so document work routes here. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Force template mode even with keys present. Useful for CI and for a demo
# you want to be byte-for-byte reproducible.
# LLM_PROVIDER=offline

# ---------------------------------------------------------------------------
# ROUTER (all optional)
# ---------------------------------------------------------------------------

# Distributed rate limiting. Unset = in-memory, which is correct for the
# single-container deployment this ships as. Set it when running more than one
# replica against a shared provider quota.
# LLM_ROUTER_REDIS_URL=redis://localhost:6379/0

# Override the bundled model registry (models, limits, prices, priorities).
# LLM_ROUTER_MODELS=/path/to/models.yaml

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------

# Read documents with a vision model instead of tesseract+heuristics. Uses the
# router, so it needs a vision-capable provider (currently Gemini).
DOC_EXTRACTOR=offline

# Cache generated text by content hash. Recommended: removes API cost during
# iteration and makes a rehearsed demo immune to rate limits.
LLM_CACHE_ENABLED=1

# Pause between checks so the live view is readable. Presentation only.
# Set to 0 for real throughput (tests run with 0).
CHECK_DELAY_MS=400

# Seed the queue with the labelled demo cases when the database is empty.
# SEED_DEMO_CASES=1

# Point SQLite at local disk if the project lives on OneDrive, a mapped
# network drive, or any synced folder.
# VO_DB_PATH=C:/temp/vendor-cases.db
